FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_EMAILJS_SERVICE_ID
ARG VITE_EMAILJS_TEMPLATE_CONTACT
ARG VITE_EMAILJS_TEMPLATE_REPLY
ARG VITE_EMAILJS_PUBLIC_KEY
ARG VITE_LOGROCKET_ID

ENV VITE_EMAILJS_SERVICE_ID=$VITE_EMAILJS_SERVICE_ID
ENV VITE_EMAILJS_TEMPLATE_CONTACT=$VITE_EMAILJS_TEMPLATE_CONTACT
ENV VITE_EMAILJS_TEMPLATE_REPLY=$VITE_EMAILJS_TEMPLATE_REPLY
ENV VITE_EMAILJS_PUBLIC_KEY=$VITE_EMAILJS_PUBLIC_KEY
ENV VITE_LOGROCKET_ID=$VITE_LOGROCKET_ID

RUN npm run build

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]